{
  // tsgolint (type-aware `vp check`) reads the nearest `tsconfig.json` and
  // never `tsconfig.test.json`; this hands the tests the same options and
  // `paths`, plus the sibling workspace packages resolved to their `src/` so
  // the lint, which runs before any build in CI, sees real types (the
  // `check` task keeps type-checking against their built `dist/`).
  "extends": "../tsconfig.test.json",
  "compilerOptions": {
    "paths": {
      "@thomasfosterau/effect-sitemap": ["../src/index.ts"],
      "@thomasfosterau/effect-json-feed": ["../../json-feed/src/index.ts"],
      "@thomasfosterau/effect-web/observability": ["../../web/src/observability/index.ts"]
    }
  }
}
