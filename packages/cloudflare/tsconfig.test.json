{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"],
    // Tests import the package by name, as a consumer would; the mapping
    // resolves that name to `src/` so the type gate never needs this
    // package's `dist/` first (the sibling's `dist/` it does need — the
    // `check` task's build edge). Relative to this file.
    "paths": {
      "@thomasfosterau/effect-web-cloudflare": ["./src/index.ts"],
      "@thomasfosterau/effect-web-cloudflare/hyperdrive": ["./src/hyperdrive/index.ts"],
      "@thomasfosterau/effect-web-cloudflare/queues": ["./src/queues/index.ts"],
      "@thomasfosterau/effect-web-cloudflare/cache": ["./src/cache/index.ts"],
      "@thomasfosterau/effect-web-cloudflare/testing": ["./src/testing/index.ts"]
    }
  },
  "include": ["src", "tests"]
}
