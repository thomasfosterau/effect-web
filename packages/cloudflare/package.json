{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-web-cloudflare",
  "version": "0.0.0",
  "description": "The Cloudflare Workers / Alchemy runtime scaffold for Effect: per-request binding layers, the Scheduler bridge, request metrics, the Hyperdrive database seam, queue producer/consumer glue, the KV read-through resource cache, and in-memory binding stubs for tests.",
  "keywords": [
    "alchemy",
    "cloudflare-workers",
    "effect",
    "hyperdrive",
    "kv",
    "queues",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-web#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-web/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-web.git",
    "directory": "packages/cloudflare"
  },
  "files": [
    "dist",
    "README.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hyperdrive": {
      "types": "./dist/hyperdrive.d.ts",
      "default": "./dist/hyperdrive.js"
    },
    "./queues": {
      "types": "./dist/queues.d.ts",
      "default": "./dist/queues.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-web": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "catalog:peers",
    "alchemy": "catalog:peers",
    "effect": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
