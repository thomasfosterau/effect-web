{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-langtag",
  "version": "0.1.0",
  "description": "BCP 47 language tags (RFC 5646) and language-range matching (RFC 4647) for Effect: parse and canonicalise a tag, read its subtags, filter and look up tags against a priority list, and negotiate a language from Accept-Language.",
  "keywords": [
    "accept-language",
    "bcp47",
    "effect",
    "language-tag",
    "rfc4647",
    "rfc5646",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-web#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-web/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-web.git",
    "directory": "packages/langtag"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
