{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-web",
  "version": "0.1.0",
  "description": "Framework-neutral web request/response utilities on effect/http (cache-control and security headers, Vary, the cross-origin guard, client IP, an SSRF-guarded fetch, structured logging, an allow-listed span tracer), Service Worker caching strategies, and browser platform APIs as Effect services (Web Locks, navigator, page visibility, media queries, wake lock, BroadcastChannel, permission state) with in-memory test doubles.",
  "keywords": [
    "browser",
    "cloudflare-workers",
    "content-negotiation",
    "effect",
    "fetch",
    "http",
    "navigator",
    "service-worker",
    "ssrf",
    "sveltekit",
    "testing",
    "typescript",
    "web-locks"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-web#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-web/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-web.git",
    "directory": "packages/web"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./net": {
      "types": "./dist/net.d.ts",
      "default": "./dist/net.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "default": "./dist/observability.js"
    },
    "./negotiate": {
      "types": "./dist/negotiate.d.ts",
      "default": "./dist/negotiate.js"
    },
    "./service-worker": {
      "types": "./dist/service-worker.d.ts",
      "default": "./dist/service-worker.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-browser": "catalog:",
    "@thomasfosterau/effect-jsonapi": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-browser": "catalog:peers",
    "@thomasfosterau/effect-jsonapi": "catalog:peers",
    "effect": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@effect/platform-browser": {
      "optional": true
    },
    "@thomasfosterau/effect-jsonapi": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
