{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/effect-web-robots",
  "version": "0.0.0",
  "description": "The Robots Exclusion Protocol (RFC 9309) for Effect: parse, encode and match robots.txt, evaluate a crawl decision with the §2.3.1 failure posture over a pluggable cache, and build the robots.txt a site serves.",
  "keywords": [
    "effect",
    "rfc9309",
    "robots-exclusion",
    "robots.txt",
    "typescript",
    "web-crawler"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-web#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-web/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-web.git",
    "directory": "packages/robots"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22"
  }
}
