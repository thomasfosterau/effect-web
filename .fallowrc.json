{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/web/src/index.ts",
    "packages/web/src/net/index.ts",
    "packages/web/src/observability/index.ts",
    "packages/web/src/negotiate/index.ts",
    "packages/cloudflare/src/index.ts",
    "packages/cloudflare/src/hyperdrive/index.ts",
    "packages/cloudflare/src/queues/index.ts",
    "packages/cloudflare/src/cache/index.ts",
    "packages/cloudflare/src/testing/index.ts",
    "packages/posthog/src/index.ts",
    "packages/posthog/src/alchemy/index.ts",
    "packages/posthog/src/server/index.ts",
    "packages/posthog/src/browser/index.ts",
    "packages/robots/src/index.ts",
    "packages/sitemap/src/index.ts",
    "packages/cloudflare/src/robots/index.ts",
    "packages/*/tests/**/*.test.ts",
    "packages/*/tests/**/*.types.ts",
    "**/vite.config.ts",
    "vite.package.ts",
    "scripts/check-dist-imports.mjs"
  ],
  "ignorePatterns": ["**/dist/**", "**/docs/**", "**/coverage/**"],
  "ignoreDependencies": [
    "@types/node",
    "@effect/platform-node",
    "effect-solutions",
    "@effect/docgen",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "tsx",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "@changesets/changelog-github",
    "@vitest/coverage-istanbul",
    "fallow"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "web",
        "patterns": ["packages/web/**"]
      },
      {
        "name": "cloudflare",
        "patterns": ["packages/cloudflare/**"]
      },
      {
        "name": "posthog",
        "patterns": ["packages/posthog/**"]
      },
      {
        "name": "robots",
        "patterns": ["packages/robots/**"]
      },
      {
        "name": "sitemap",
        "patterns": ["packages/sitemap/**"]
      }
    ],
    "rules": [
      {
        "from": "web",
        "allow": []
      },
      {
        "from": "cloudflare",
        "allow": ["web", "robots"]
      },
      {
        "from": "posthog",
        "allow": ["web"]
      },
      {
        "from": "robots",
        "allow": []
      },
      {
        "from": "sitemap",
        "allow": ["web"]
      }
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}
