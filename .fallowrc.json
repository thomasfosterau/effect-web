{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/web/src/index.ts",
    "packages/web/src/net/index.ts",
    "packages/web/src/observability/index.ts",
    "packages/web/src/negotiate/index.ts",
    "packages/web/src/service-worker/index.ts",
    "packages/web/src/browser/index.ts",
    "packages/web/src/testing/index.ts",
    "packages/robots/src/index.ts",
    "packages/sitemap/src/index.ts",
    "packages/rss-feed/src/index.ts",
    "packages/atom-feed/src/index.ts",
    "packages/json-feed/src/index.ts",
    "packages/uri-template/src/index.ts",
    "packages/langtag/src/index.ts",
    "packages/langtag/src/registry/index.ts",
    "packages/*/tests/**/*.test.ts",
    "packages/*/tests/**/*.types.ts",
    "**/vite.config.ts",
    "vite.package.ts",
    "scripts/check-dist-imports.mjs",
    "scripts/generate-language-subtag-registry.mjs"
  ],
  "ignorePatterns": ["**/dist/**", "**/docs/**", "**/coverage/**"],
  "ignoreDependencies": [
    "@types/node",
    "@effect/docgen",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "tsx",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "@changesets/changelog-github",
    "@vitest/coverage-istanbul",
    "fallow"
  ],
  "ignoreExports": [
    {
      "file": "packages/web/src/browser/*.ts",
      "exports": ["make", "layer", "changes", "requestPermission"]
    },
    {
      "file": "packages/web/src/testing/*.ts",
      "exports": ["make", "layer", "Control", "Fixture", "Options"]
    }
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "web",
        "patterns": ["packages/web/**"]
      },
      {
        "name": "robots",
        "patterns": ["packages/robots/**"]
      },
      {
        "name": "sitemap",
        "patterns": ["packages/sitemap/**"]
      },
      {
        "name": "rss-feed",
        "patterns": ["packages/rss-feed/**"]
      },
      {
        "name": "atom-feed",
        "patterns": ["packages/atom-feed/**"]
      },
      {
        "name": "json-feed",
        "patterns": ["packages/json-feed/**"]
      },
      {
        "name": "uri-template",
        "patterns": ["packages/uri-template/**"]
      },
      {
        "name": "langtag",
        "patterns": ["packages/langtag/**"]
      }
    ],
    "rules": [
      {
        "from": "web",
        "allow": []
      },
      {
        "from": "robots",
        "allow": []
      },
      {
        "from": "sitemap",
        "allow": ["web", "json-feed"]
      },
      {
        "from": "rss-feed",
        "allow": []
      },
      {
        "from": "atom-feed",
        "allow": []
      },
      {
        "from": "json-feed",
        "allow": []
      },
      {
        "from": "uri-template",
        "allow": []
      },
      {
        "from": "langtag",
        "allow": []
      }
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}
